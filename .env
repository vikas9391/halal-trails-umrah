# Public site URL used for Stripe redirects
SITE_URL=https://halal-trails.com
PORT=3000
NODE_ENV=development

# Stripe (use sk_test_ / whsec_ values until launch testing is complete)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Transactional email. Verify halal-trails.com with your email provider first.
RESEND_API_KEY=re_REPLACE_ME
REGISTRATION_EMAIL_FROM=Halal Trails Registration <registration@halal-trails.com>
BILLING_EMAIL_FROM=Halal Trails Billing <billing@halal-trails.com>
INFO_EMAIL=info@halal-trails.com
TEAM_EMAIL=registration@halal-trails.com

# Generate a 32-byte key:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOOKING_ENCRYPTION_KEY=HxA1w9HF2il9m/TIxm80Tz6D/fccJsTWCoD5amMvXMY=

# Optional manual payment instructions shown in confirmation emails
ZELLE_EMAIL=billing@halal-trails.com
CASHAPP_HANDLE=
